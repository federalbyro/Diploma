APP_ENV=dev
LOG_LEVEL=INFO
POSTGRES_DSN=postgresql+psycopg2://postgres:postgres@postgres:5432/diploma
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MODEL_NAME=sentence-transformers/LaBSE
MODEL_DEVICE=cpu
MODEL_BATCH_SIZE=16
MODEL_CACHE_DIR=/models
QDRANT_PRODUCT_BATCH_SIZE=128
QDRANT_CATEGORY_BATCH_SIZE=128
CATEGORY_TOP_K=5
PRODUCT_SEARCH_LIMIT=20
SUPPLIER_TOP_K=10
SUPPLIER_MIN_SIMILARITY=0.20
UPLOAD_DIR=/tmp/uploads
